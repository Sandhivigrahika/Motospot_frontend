{
  "expo": {
    "name": "Motospot",
    "slug": "motospot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.motospotapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
    "expo-location",
    {
      "locationWhenInUsePermission": "Motospot uses your location to attach an accurate pickup point to your bookings."
    }
  ]
    ],
    "extra": {
      "eas": {
        "projectId": "f53ede52-5490-45ad-9923-d33e8a9dc310"
      }
    },
    "owner": "neelhans007s-organization"
  }
}
